# App
APP_ENV=local
APP_NAME=Gamified Study Hub

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost,http://localhost:5173
JWT_SECRET=change-this-local-development-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamified_study_hub
POSTGRES_USER=gsh_user
POSTGRES_PASSWORD=gsh_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth2 (social login)
GOOGLE_CLIENT_ID=dummy-client-id-for-local-dev
GOOGLE_CLIENT_SECRET=dummy-client-secret-for-local-dev

# MFA (TOTP)
MFA_ENCRYPTION_KEY=eqPe2tprz7fMHhFyQvlTsQY5hKCI2inQ9xlhCoI/Xtw=

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aquvix.site
MAIL_BASE_URL=http://localhost

# Nginx
NGINX_PORT=80

# ---------------------------------------------------------------------------
# Optional platform integrations (MongoDB / Elasticsearch / Kafka / tracing).
# All default OFF so a plain `docker compose up` stays light. To use one:
#   1) start its stack:  docker compose --profile <nosql|search|messaging|observability|full> up -d
#   2) flip its flag to true below and restart the backend.
# See docs/architecture/platform-integrations.md.
# ---------------------------------------------------------------------------
APP_MONGO_ENABLED=false
APP_ES_ENABLED=false
APP_KAFKA_ENABLED=false
# Trace sampling: 0.0 = off, 1.0 = trace every request (use 1.0 locally with the observability stack).
APP_TRACING_SAMPLING=0.0
# Reference feature exercising MongoDB + Kafka + Elasticsearch (needs the three flags above ON).
APP_FEATURE_ACTIVITY_ENABLED=false

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=gamified_study_hub
# Or set a full connection string (overrides host/port/db): MONGODB_URI=mongodb://mongodb:27017/gamified_study_hub

# Elasticsearch
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Kafka (in-container apps use kafka:9092; host apps via `make backend-run` use localhost:9094)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_CONSUMER_GROUP=gsh-backend
KAFKA_UI_PORT=8085

# Observability (traces -> OTel Collector -> Tempo; metrics scraped by Prometheus; logs via Promtail -> Loki)
OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Pre-wired "modern stack" — all OFF/local by default (see docs/architecture/prewired-stack.md)
# ---------------------------------------------------------------------------
# Object storage: local (filesystem) | s3 (AWS S3 / Cloudflare R2 / MinIO)
APP_STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_PATH=./data/storage
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=auto
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=
APP_STORAGE_S3_PATH_STYLE=true
# Upload size caps (also enforce at the reverse proxy)
APP_UPLOAD_MAX_FILE_SIZE=25MB
APP_UPLOAD_MAX_REQUEST_SIZE=30MB
# Caching (@Cacheable): caffeine (in-process) | redis (distributed)
APP_CACHE_ENABLED=false
APP_CACHE_PROVIDER=caffeine
# Redisson distributed locks / atomic ops (coin-ledger idempotency)
APP_REDISSON_ENABLED=false
# @Scheduled jobs with ShedLock single-node locking
APP_SCHEDULING_ENABLED=false
# Idempotency-Key replay for unsafe requests
APP_IDEMPOTENCY_ENABLED=false
APP_IDEMPOTENCY_TTL=86400
# WebSocket/STOMP realtime (also add /ws to SecurityConfig permit rules when enabling)
APP_WEBSOCKET_ENABLED=false
APP_WEBSOCKET_ALLOWED_ORIGINS=*
# AWS Secrets Manager runtime client (needs a region when true)
APP_SECRETS_MANAGER_ENABLED=false
